{
  "manifest_version": 3,
  "name": "Lumina — Local AI for any webpage",
  "short_name": "Lumina",
  "version": "0.3.0",
  "description": "Ask any question about the page you're viewing, or fact-check claims against web sources. Powered by a local Qwen model via Ollama.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lumina — Ask this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://localhost:11434/*",
    "https://html.duckduckgo.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
